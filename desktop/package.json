{
  "name": "focus-desktop",
  "productName": "Focus",
  "version": "3.0.11",
  "description": "Focus \u2014 Todoist focus timer (macOS desktop shell)",
  "author": "Carl Galloway",
  "main": "main.js",
  "scripts": {
    "prestart": "node copy-app.js",
    "start": "electron .",
    "predist": "node copy-app.js",
    "dist": "electron-builder --mac dmg",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.carlgalloway.focus",
    "productName": "Focus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "app/**/*",
      "compact-menu.html",
      "compact-menu-preload.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "../icon-512.png",
      "target": [
        "dmg"
      ]
    }
  }
}
